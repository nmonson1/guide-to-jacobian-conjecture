{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmonson1.github.io/guide-to-jacobian-conjecture/schemas/public-package-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "title",
    "kind",
    "statement",
    "lead_public_claim_id",
    "members",
    "related_package_slugs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/slug"},
    "slug": {"$ref": "#/$defs/slug"},
    "title": {"$ref": "#/$defs/nonemptyString"},
    "kind": {"enum": ["result", "open_problem"]},
    "statement": {"$ref": "#/$defs/nonemptyString"},
    "lead_public_claim_id": {
      "type": "string",
      "pattern": "^JCG-CLAIM-[0-9]{4}$"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_claim_id",
          "title",
          "statement",
          "inclusion",
          "role"
        ],
        "properties": {
          "public_claim_id": {
            "type": "string",
            "pattern": "^JCG-CLAIM-[0-9]{4}$"
          },
          "title": {"$ref": "#/$defs/nonemptyString"},
          "statement": {"$ref": "#/$defs/nonemptyString"},
          "inclusion": {"enum": ["defining", "shared"]},
          "role": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "related_package_slugs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
